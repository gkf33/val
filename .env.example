# --- Datenbank ---
DATABASE_URL="postgresql://guestlist:guestlist@localhost:5432/guestlist"
# Für Integrationstests (wird von `npm run test:db` geleert, Name muss auf _test enden)
TEST_DATABASE_URL="postgresql://guestlist:guestlist@localhost:5432/guestlist_test"

# --- App ---
APP_URL="http://localhost:3000"
# Langer Zufallswert, z. B. `openssl rand -hex 32`
APP_SECRET="dev-secret-bitte-ersetzen-0123456789abcdef"
# Komma-getrennt; nur diese E-Mails dürfen ins Admin-Backend
ADMIN_EMAILS="admin@example.com"
TZ_DISPLAY="Europe/Berlin"

# --- Mail ---
# console = Mails ins Server-Log; file = JSON-Dateien in MAIL_OUTBOX_DIR; smtp = z. B. Mailpit (localhost:1025)
MAIL_TRANSPORT="console"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Guestlist <noreply@localhost>"

# --- Regeln (Standardwerte aus der Spezifikation) ---
MAX_GROUP_SIZE="5"
MAX_BOOKINGS_PER_ACCOUNT="1"
PAYMENT_DEADLINE_MINUTES="60"
PAYMENT_CUTOFF_HOURS="24"
PAYMENT_REMINDER_MINUTES="40"
WAITLIST_CUTOFF_HOURS="24"
SELF_CANCEL_HOURS="72"
DATA_RETENTION_DAYS="30"
AMOUNT_TOLERANCE_EUR="0"

# --- Feature-Flags ---
TRUSTED_AUTO_APPROVE="false"
UNIQUE_CENT_AMOUNTS="false"
WALLET_PASSES="false"

# --- Später (Phase 3) ---
PAYPAL_ME_USER=""
INBOUND_WEBHOOK_SECRET=""
CRON_SECRET=""

# --- E2E (Playwright) ---
E2E_DATABASE_URL="postgresql://guestlist:guestlist@localhost:5432/guestlist_e2e"
